# ---- docker compose ----
# Runs a local MongoDB container. Remove this line and set MONGO_URL to use an external database.
COMPOSE_PROFILES=local-db
# Image to run; `docker compose build` builds it locally, `docker compose pull` fetches it.
CAPES_IMAGE=ghcr.io/inventivetalentdev/api.capes.dev:latest
# API replicas on this server, and the port the load balancer listens on
APP_REPLICAS=2
HTTP_PORT=3026
APP_MEMORY_LIMIT=512M

# ---- app ----
# Every setting can also be given as <NAME>_FILE=/path/to/file (e.g. a docker secret).
# Settings that aren't set here fall back to config.js if one is mounted (CONFIG_FILE=/path/to/config.js).

# Either a full connection string (replica sets etc.) ...
MONGO_URL=mongodb://mongo:27017/capes
# ... or the individual parts
#MONGO_ADDRESS=
#MONGO_PORT=27017
#MONGO_USER=
#MONGO_PASS=
#MONGO_DATABASE=capes

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_HASH=

SENTRY_DSN=
#SENTRY_ENVIRONMENT=production

# InfluxDB 1.x for metrics; metrics are disabled when INFLUX_HOST is empty
INFLUX_HOST=
#INFLUX_PORT=8086
#INFLUX_PROTOCOL=http
#INFLUX_USERNAME=
#INFLUX_PASSWORD=
#INFLUX_DATABASE=

# How long (ms) a replica keeps serving after SIGTERM while load balancers take it out of rotation
#SHUTDOWN_DELAY=5000
